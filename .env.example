# ===== Telegram =====
# Токен бота от @BotFather
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram-ID администраторов через запятую (только они могут пользоваться ботом).
# Если оставить пустым — бот при /start покажет тебе твой ID, впиши его сюда и перезапусти бота.
ADMIN_IDS=

# ===== Роутер TP-Link Archer C80 =====
# Адрес веб-интерфейса роутера (у C80 по умолчанию http://192.168.0.1)
ROUTER_HOST=http://192.168.0.1

# ЛОКАЛЬНЫЙ пароль администратора роутера (тот, что вводишь при входе в веб-морду).
# Логин через TP-Link ID НЕ поддерживается роутером для API.
ROUTER_PASSWORD=

# Имя пользователя (на C80 обычно не используется, оставь admin)
ROUTER_USERNAME=admin

# Таймаут запросов к роутеру, секунд
ROUTER_TIMEOUT=30

# ===== Прокси для Bot API (опционально) =====
# Если провайдер рвёт соединение с api.telegram.org (ConnectionResetError),
# впиши прокси — бот будет ходить в Telegram через него:
#   TG_PROXY=http://хост:порт
#   TG_PROXY=socks5://хост:порт     (нужен пакет aiohttp-socks: pip install aiohttp-socks)
# TG_PROXY=http://127.0.0.1:8080
